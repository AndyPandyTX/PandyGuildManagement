# BigWigsMods packager settings: the release zip holds one folder named like
# the .toc, so it unzips straight into Interface\AddOns.
package-as: PandyGuildManagement

ignore:
  - preview
  - screenshots
  - tools
  - curseforge-description.md
  - .github
  - .gitignore
  - .pkgmeta

# Libraries for the minimap button and data broker launcher. Fetched when
# packaging; for testing from git, copy them into Libs\ by hand.
externals:
  Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1
  Libs/LibDBIcon-1.0: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
